# Keep line endings sane across Windows/Linux. Everything is LF in the working
# tree on every platform (eol=lf overrides core.autocrlf), so Docker build
# contexts hash identically and there is no CRLF<->LF churn. .bat/.cmd stay CRLF.
* text=auto eol=lf

*.sh    text eol=lf
*.bash  text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
docker-entrypoint.sh text eol=lf
nginx.conf      text eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff  binary
*.woff2 binary
