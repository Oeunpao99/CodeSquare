{
  "name": "codesquare-agent",
  "displayName": "CodeSquareAgent",
  "description": "AI coding assistant — chat, create files, and edit code from VS Code.",
  "version": "0.1.0",
  "publisher": "codesphere",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["AI", "Programming", "Other"],
  "keywords": ["ai", "code", "assistant", "chat", "codesquare"],
  "icon": "assets/icon.png",
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codesquare",
          "title": "CodeSquareAgent",
          "icon": "assets/robot.svg"
        }
      ]
    },
    "views": {
      "codesquare": [
        {
          "type": "webview",
          "id": "codesquare.agentPanel",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "codesquare.login",
        "title": "CodeSquare: Login",
        "category": "CodeSquare"
      },
      {
        "command": "codesquare.logout",
        "title": "CodeSquare: Logout",
        "category": "CodeSquare"
      },
      {
        "command": "codesquare.newChat",
        "title": "CodeSquare: New Chat",
        "category": "CodeSquare"
      },
      {
        "command": "codesquare.openPanel",
        "title": "CodeSquare: Open Agent Panel",
        "category": "CodeSquare"
      }
    ],
    "configuration": {
      "title": "CodeSquareAgent",
      "properties": {
        "codesquare.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Backend API URL"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
