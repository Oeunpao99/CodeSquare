{
  "name": "codesquare-agent",
  "displayName": "CodeSquareAgent",
  "description": "AI coding assistant — chat, create files, and edit code from VS Code.",
  "version": "0.1.0",
  "publisher": "codesphere",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming",
    "Other"
  ],
  "keywords": [
    "ai",
    "code",
    "assistant",
    "chat",
    "codesquare"
  ],
  "icon": "assets/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codesquare",
          "title": "CodeSquareAgent",
          "icon": "assets/robot.svg"
        }
      ]
    },
    "views": {
      "codesquare": [
        {
          "type": "webview",
          "id": "codesquare.agentPanel",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "codesquare.login",
        "title": "CodeSquare: Login",
        "category": "CodeSquare"
      },
      {
        "command": "codesquare.logout",
        "title": "CodeSquare: Logout",
        "category": "CodeSquare"
      },
      {
        "command": "codesquare.switchAccount",
        "title": "CodeSquare: Switch Account",
        "category": "CodeSquare"
      },
      {
        "command": "codesquare.newChat",
        "title": "CodeSquare: New Chat",
        "category": "CodeSquare"
      },
      {
        "command": "codesquare.openPanel",
        "title": "CodeSquare: Open Agent Panel",
        "category": "CodeSquare"
      },
      {
        "command": "codesquare.keepFile",
        "title": "Keep agent changes in this file",
        "category": "CodeSquare",
        "icon": "$(check)"
      },
      {
        "command": "codesquare.undoFile",
        "title": "Undo agent changes in this file",
        "category": "CodeSquare",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "codesquare.keepFile", "when": "codesquare.fileHasChanges" },
        { "command": "codesquare.undoFile", "when": "codesquare.fileHasChanges" }
      ],
      "editor/title": [
        {
          "command": "codesquare.undoFile",
          "when": "codesquare.fileHasChanges",
          "group": "navigation@1"
        },
        {
          "command": "codesquare.keepFile",
          "when": "codesquare.fileHasChanges",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "codesquare.undoFile",
          "when": "codesquare.fileHasChanges",
          "group": "7_modification"
        },
        {
          "command": "codesquare.keepFile",
          "when": "codesquare.fileHasChanges",
          "group": "7_modification"
        }
      ]
    },
    "configuration": {
      "title": "CodeSquareAgent",
      "properties": {
        "codesquare.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Backend API URL"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./ && npm run check:webview && node esbuild.mjs",
    "package": "tsc -p ./ && npm run check:webview && node esbuild.mjs --prod",
    "check:webview": "tsc -p tsconfig.webview.json",
    "watch": "tsc -watch -p ./",
    "watch:webview": "node esbuild.mjs --watch",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.2",
    "highlight.js": "^11.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0"
  }
}
