# -----------------------------------------------------------------------------
# CodeSquare — production environment
# Copy to `.env.prod` and fill in real values. `.env.prod` is git-ignored.
# Used by: docker compose --env-file .env.prod -f docker/docker-compose.prod.yml
# -----------------------------------------------------------------------------

# ---- PostgreSQL (the `db` service + DATABASE_URL are derived from these) ----
POSTGRES_USER=codesquare
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=codesquare
# DATABASE_URL is set automatically by compose to point at the `db` service.
# Only set it here to use an external managed Postgres instead:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ---- Public HTTP port (host -> frontend/nginx). Terminate TLS in front. ----
# Pick a port free on the host. On the shared VM 8080/8082/8083/8085/8086/8090
# are already in use by other stacks; 8084 is free.
HTTP_PORT=8084

# ---- Auth / JWT ----
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_hex_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CodeSquare Notes credential vault — MUST differ from SECRET_KEY ----
# Rotating this makes previously stored credential values unreadable.
NOTE_SECRET_KEY=CHANGE_ME_different_hex_32_bytes

# ---- CORS: public origin(s) of the site, comma-separated ----
CORS_ORIGINS=https://your-domain.example

# ---- SQLAlchemy echo (leave false in production) ----
SQL_ECHO=false

# ---- Google OAuth (optional). Backend verifies, frontend needs it at build. ----
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ---- AI provider ----
# Azure OpenAI takes precedence over OPENAI_API_KEY when AZURE_* are set.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_VISION_DEPLOYMENT=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_REASONING_EFFORT=low
