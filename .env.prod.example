# -----------------------------------------------------------------------------
# CodeSquare — production environment
# Copy to `.env.prod` and fill in real values. `.env.prod` is git-ignored.
# Used by: docker compose --env-file .env.prod -f docker/docker-compose.prod.yml
# -----------------------------------------------------------------------------

# ---- PostgreSQL (the `db` service + DATABASE_URL are derived from these) ----
POSTGRES_USER=codesquare
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=codesquare
# DATABASE_URL is set automatically by compose to point at the `db` service.
# Only set it here to use an external managed Postgres instead:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ---- Public HTTP port (host -> frontend/nginx). Terminate TLS in front. ----
# Pick a port free on the host. On the shared VM 8080/8082/8083/8085/8086/8090
# are already in use by other stacks; 8084 is free.
HTTP_PORT=8084

# ---- Runtime mode ----
# Anything other than dev/development/local/test = production: /docs, /redoc and
# /openapi.json are hidden and HSTS is sent.
ENV=production
# Set to 1 only if a trusted reverse proxy (nginx/Cloudflare) sets
# X-Forwarded-For — the rate limiter then keys on the real client IP.
TRUST_PROXY=1
# Comma-separated Host header allow-list. Leave as * to disable the check.
ALLOWED_HOSTS=your-domain.example
# Max accepted request body (bytes). Default 6 MiB.
MAX_BODY_BYTES=6291456

# ---- Auth / JWT ----
# REQUIRED. The app refuses to boot if this is unset, < 32 chars, or the old
# repo default. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it logs everyone out (all existing tokens become invalid).
SECRET_KEY=CHANGE_ME_random_48_plus_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Untrusted code grader (lesson exercises / challenges) ----
# Behavioural tests run the learner's code in a locked-down child process.
# Set false to disable that entirely (static content checks still work).
CODE_EXEC_ENABLED=true
CODE_EXEC_TIMEOUT=6      # wall-clock seconds per submission
CODE_EXEC_CPU=4          # CPU seconds (POSIX RLIMIT_CPU)
CODE_EXEC_MEM_MB=256     # address-space cap (POSIX RLIMIT_AS)

# ---- Admin console (/admin-portal) ----
# On startup: if this email has no account, one is created (ADMIN_PASSWORD
# required) and made admin. If it exists, it's just granted admin — the password
# is left alone unless ADMIN_RESET_PASSWORD=true. Leave ADMIN_EMAIL blank to
# manage admins with backend/make_admin.py instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_USERNAME=              # optional; defaults to the email's local part
# ADMIN_RESET_PASSWORD=false   # set true once to force-reset the password, then unset

# ---- CodeSquare Notes credential vault — MUST differ from SECRET_KEY ----
# Rotating this makes previously stored credential values unreadable.
NOTE_SECRET_KEY=CHANGE_ME_different_hex_32_bytes

# ---- CORS: public origin(s) of the site, comma-separated ----
CORS_ORIGINS=https://your-domain.example

# ---- SQLAlchemy echo (leave false in production) ----
SQL_ECHO=false

# ---- Google OAuth (optional). Backend verifies, frontend needs it at build. ----
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ---- AI provider ----
# Azure OpenAI takes precedence over OPENAI_API_KEY when AZURE_* are set.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_VISION_DEPLOYMENT=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_REASONING_EFFORT=low
